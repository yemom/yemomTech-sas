# =============================================================
# YemomBizGrow STAGING environment — copy to .env.staging and fill in.
# .env.staging is gitignored (`.env.*`); NEVER commit real values.
#
# Secrets (generate once, store in a secret manager for the real host):
#   JWT_SECRET      -> openssl rand -base64 64
#   ENCRYPTION_KEY  -> openssl rand -base64 32
#   DB_PASSWORD     -> openssl rand -base64 24
# =============================================================

# --- TLS hosts (Caddy site addresses; include scheme and port) ---
# Rehearsal without a public domain:
STAGING_APP_HOST=https://localhost:4443
STAGING_API_HOST=https://localhost:8443
# Real staging domain: "https://app.staging.yourdomain.com:4443" etc.

# --- Host ports for the HTTPS listeners ---
STAGING_HTTPS_APP_PORT=4443
STAGING_HTTPS_API_PORT=8443

# --- Public origins ---
# The frontend origin (exact, no trailing slash) — backend CORS allowlist.
STAGING_FRONTEND_ORIGIN=https://localhost:4443
# The API origin BAKED INTO the frontend bundle (must match STAGING_API_HOST).
STAGING_API_PUBLIC_URL=https://localhost:8443/api/v1

# --- Database (staging-only instance, not reachable from the host) ---
STAGING_DB_NAME=YemomBizGrowStaging
STAGING_DB_USER=yemom_staging
STAGING_DB_PASSWORD=replace_with_openssl_rand_base64_24

# --- Security secrets (REQUIRED; the stack refuses to start without them) ---
STAGING_JWT_SECRET=replace_with_openssl_rand_base64_64
STAGING_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# --- Providers (leave empty -> verify-providers.mjs reports SKIP honestly) ---
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_SECRET=
STAGING_GOOGLE_REDIRECT_URI=https://localhost:4443/workspace/analytics/callback
STAGING_CHAPA_SECRET_KEY=
STAGING_CHAPA_WEBHOOK_SECRET=
STAGING_OPENAI_API_KEY=

# --- SMTP (aggregate /actuator/health is 503 until this is configured;
#     readiness — the orchestrator probe — is independent) ---
STAGING_MAIL_HOST=
STAGING_MAIL_PORT=587
STAGING_MAIL_USERNAME=
STAGING_MAIL_PASSWORD=
STAGING_MAIL_FROM=staging-noreply@yourdomain.com
STAGING_MAIL_FROM_NAME=YemomBizGrow Staging
