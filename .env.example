# =============================================================
# YemomTech (YemomBizGrow) — environment template
# Copy to `.env` and replace every value marked CHANGE_ME.
# NEVER commit a real `.env` file. NEVER put secrets in
# NEXT_PUBLIC_* variables (they are bundled into browser JS).
# Generate a JWT secret with:
#   PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object {Get-Random -Maximum 256}))
#   Linux/macOS: openssl rand -base64 64
# =============================================================

# ---- Application ----
APP_ENV=development
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- Database ----
POSTGRES_DB=YemomBizGrow
POSTGRES_USER=YemomBizGrow_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=jdbc:postgresql://127.0.0.1:5632/YemomBizGrow
DATABASE_USERNAME=YemomBizGrow_user
DATABASE_PASSWORD=CHANGE_ME_strong_db_password

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6637
REDIS_PASSWORD=CHANGE_ME_redis_password_or_empty_for_local_dev

# ---- Security (JWT) ----
# Minimum 32 bytes of entropy. Dev-only value lives in application-dev.yml.
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_64_chars_long
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Cookies / CSRF ----
# dev: SameSite=Lax (localhost frontend -> localhost backend is same-site)
# prod: SameSite=None; Secure (Vercel frontend -> Render backend is cross-site)
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082/api/v1
FRONTEND_URL=http://localhost:3001

# ---- CORS (comma separated exact origins, no wildcards) ----
# 3001: this machine's 3000 is taken by Docker/wslrelay; use 3000 if free.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---- Login throttling ----
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# ---- Encryption (AES-256-GCM for OAuth credential storage) ----
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_generate_32_byte_base64_key

# ---- Google OAuth Integration ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include: https://app.yourdomain.com/workspace/analytics/callback
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/workspace/analytics/callback

# ---- Email (SMTP / transactional provider) ----
# Examples: smtp.sendgrid.net:587, smtp.mailgun.org:587, email-smtp.us-east-1.amazonaws.com:587
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=BizGrow

# ---- Chapa Payment Gateway (Ethiopian Payments: Telebirr, CBE Birr, Cards) ----
# Get test credentials at https://dashboard.chapa.co
# Set to 'mock' or leave empty for offline sandbox testing
CHAPA_SECRET_KEY=CHANGE_ME_chapa_secret_key
CHAPA_WEBHOOK_SECRET=CHANGE_ME_webhook_secret_hash

# ---- AI Engine (OpenAI / DeepSeek / Offline LLM) ----
# If omitted or empty, BizGrow uses OfflineAiProvider (deterministic business rules)
OPENAI_API_KEY=CHANGE_ME_openai_api_key

# ---- Render / production deployment notes ----
# These are set in Render's environment group, not in .env:
# RENDER_EXTERNAL_URL  (set automatically by Render)
# DATABASE_URL         (set by Render's Postgres add-on; overrides DATABASE_URL above)